
@{
    ViewBag.Title = "Buscardor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var idUsuario ='@ViewBag.id';
    var idArea = @ViewBag.idArea;
    var idComision =@ViewBag.idComision;
    var usuarioCaptura = @ViewBag.usuarioCaptura;
</script>


<h2>Buscador por Comisión:</h2>
<div ng-controller="ComprobacionController as vm">
    <div class="container" ng-init="vm.ObtenerAreas();">
        <form ng-submit="vm.BuscarComision()">
            <div class="row">
                <div class="col-md-3">
                    <label>Por no. Oficio</label>
                    <input type="text" class="form-control" ng-model="vm.noOficio" />
                </div>
                <div class="col-md-3">
                    <label>Por periodo</label>
                    <input type="date" class="form-control" ng-model="vm.fechaInicio" />
                    <input type="date" class="form-control" ng-model="vm.fechaFin" />
                </div>
                <div class="col-md-3">
                    <label>Por Área:</label>
                    <select class="form-control" ng-model="vm.idArea" ng-change="vm.ObtenerEmpleados(a.id)">
                        <option value=null ng-hide="vm.idUsuario!='090'&&vm.idUsuario!='329'&&vm.idUsuario!='283'&&vm.idUsuario!='340'">Todos</option>
                        <option ng-repeat="a in vm.Areas" value="{{a.Id}}">{{a.Descripcion}}</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Por Personal</label>
                    <select class="form-control" ng-model="vm.noPersonal" ng-disabled="vm.Area=='0'">
                        <option value='null'>Todos</option>
                        <option ng-repeat="p in vm.Personas" value="{{p.NoEmpleado}}">{{p.Nombre+' '+p.Apellidos}}</option>
                    </select>
                    <button type="button" class="btn btn-success" ng-click="vm.BuscarComision()"><span class="fa fa-search-plus"></span> Buscar</button>
                    <button type="button" class="btn btn-secondary" ng-hide="vm.Comisiones==null||vm.Comisiones.length == 0||(vm.idUsuario!='090'&&vm.idUsuario!='329'&&vm.idUsuario!='283'&&vm.idUsuario!='340')" ng-click="vm.ExportarExcel()"><span class="fa fa fa-file-excel-o"></span> Exportar</button>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12" ng-hide="vm.Comisiones==null||vm.Comisiones.length == 0">
                    <h1>Resultados {{vm.Comisiones.length}}</h1>
                    <table class="table table-hover table-bordered">
                        <tr>
                            <th>No.Oficio</th>
                            <th>Servidor</th>
                            <th>Fecha comisión</th>
                            <th>Lugar comisión</th>
                            <th>Fecha Comprobación</th>
                            <th>Reintegro</th>
                            @*<th>M. Otorgado</th>
                                <th>M. Comprobado</th>
                                <th>M. Comprobado</th>*@
                            <th>Núm. Poliza</th>
                            <th>Anexos y Reintegro</th>
                            <th>Descargar Archivos</th>
                            <th>Permitir Correciones</th>
                        </tr>
                        <tbody>
                            <tr ng-repeat="c in vm.Comisiones">
                                <td>
                                    <button type="button" title="Descargar Anexos" class="btn btn-success" ng-click="vm.GenerarReporte(c.idComision)">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                    <button type="button" title="Editar" class="btn btn-primary" ng-click="vm.Redirect(c.idComision)" ng-hide="c.fechacomprobacion!=NULL">
                                        <i class="fa fa-edit"></i>
                                    </button>

                                    {{c.noOficio}}
                                </td>
                                <td>{{c.noEmpleado+' '+c.Nombre+' '+c.Apellidos}}</td>
                                <td>{{c.fechaInicio.substr(6,13) | date:'dd/MM/yyyy'}}</td>
                                <td>{{c.lugarComision}}</td>
                                <td>{{c.fechacomprobacion.substr(6,13) | date:'dd/MM/yyyy'}}</td>
                                <td>
                                    {{c.diferencia | currency: "$":2}}
                                    @*<button type="button" class="btn btn-success">
                                            Reintegrar
                                        </button>*@
                                </td>
                                @*<td>{{c.montoOtorgado}}</td>
                                    <td>{{c.montoComprobado}}</td>*@
                                <td>{{c.noPoliza}}</td>
                                <td>
                                    <a href="" type="button" class="fa fa-file-pdf-o fa-2x" style="color:red" ng-click="vm.MostrarDoc(c.rutaOficio)" ng-hide="c.rutaOficio==NULL"></a>
                                    <button type="button" class="btn btn-primary" ng-click="vm.ModalAnexos(c)" ng-hide="c.rutaOficio!=NULL">Cargar</button>
                                </td>
                                <td><button type="button" class="btn btn-warning" title="Descargar Archivos" ng-click="vm.generarZip(c.idComision)"><i class="fa fa-file-zip-o"></i></button></td>
                                <td><input type="checkbox" ng-model="c.permitirCorrecion" ng-change="vm.CambiarPermisoCorreccion(c)" ng-disabled="!vm.RF" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
    <div id="mdl-Anexos" modal="showModal" close="cancel()" class="modal fade modal-arriba" data-easein="expandIn" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="display: none;">
        <div div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="demo-form2" data-parsley-validate class="form-horizontal form-label-left" ng-submit="vm.AgregarAnexos()">
                    <div class="modal-header">
                        Agregar Anexos Firmados <i ng-hide="">y Reintegro</i>
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                    </div>
                    <div class="modal-body">
                        <div class=" row form-group">
                            <label class="control-label col-md-4 col-sm-4 col-xs-12" for="first-name">
                                No. Oficio: <span class="required">*</span>
                            </label>
                            <div class="col-md-6">
                                {{vm.Comision.noOficio}}
                            </div>
                        </div>
                        <div class=" row form-group">
                            <label class="control-label col-md-4 col-sm-4 col-xs-12" for="first-name">
                                Servidor: <span class="required">*</span>
                            </label>
                            <div class="col-md-6">
                                {{vm.Comision.noEmpleado+' '+vm.Comision.Nombre+' '+vm.Comision.Apellidos}}
                            </div>
                        </div>
                        <div class=" row form-group">
                            <label class="control-label col-md-4 col-sm-4 col-xs-12" for="first-name">
                                Fecha comisión: <span class="required">*</span>
                            </label>
                            <div class="col-md-6">
                                {{vm.Comision.fechaInicio.substr(6,13) | date:'dd/MM/yyyy'}}
                            </div>
                        </div>
                        <div class=" row form-group">
                            <label class="control-label col-md-4 col-sm-4 col-xs-12" for="first-name">
                                Archivo PDF: <span class="required">*</span>
                            </label>
                            <div class="col-md-6">
                                <input type="file" class="form-control" accept="application/pdf" ng-required="true" name="archivo" id="archivo" />
                            </div>
                        </div>
                    </div>
                    <div div class="modal-footer">
                        <div class="form-group">
                            <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                                <button class="btn btn-primary" type="reset" ng-click="">Cancelar</button>
                                <button type="submit" class="btn btn-success">Guardar </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    var uploadField = document.getElementById("archivo");
    uploadField.onchange = function () {
        if (this.files[0].type != "application/pdf") {
            sweetAlert("Solo puede adjuntar archivos PDF", "", "error");
            this.value = "";
            return;
        }
    };
</script>
@section scripts{
    <script src="~/Scripts/app/controladores/ComprobacionController.js"></script>
    <script src="~/Scripts/app/factory/ComprobacionFactory.js"></script>
}

