<!DOCTYPE html>
<html ng-app="comprobacionApp">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - comprobación de Gastos</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />    
    <link href="~/Content/sweetalert.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        li{
            font-size:large;
        }
    </style>
</head>
<body style="font-family:'Montserrat'">
    <nav class="navbar navbar-inverse">
        <div class="container">
            <div class="">
                <h2 style="color:gray">SISTEMA DE VIÁTICOS</h2>
                @if (ViewBag.Usuario != null)
                {
                    <ul class="nav navbar-nav">

                        <li>@Html.ActionLink("Solicitud", "solicitud", "Comprobacion", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Comprobación", "Comprobacion", "Comprobacion", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>
                            @Html.ActionLink("Buscar", "Buscardor", "Comprobacion", new { area = "" }, new { @class = "nav-link" })
                        </li>
                        @if (ViewBag.id == "090")
                        {
                            <li>
                                @Html.ActionLink("Anexo Combustible", "AnexoCombustible", "Comprobacion", new { area = "" }, new { @class = "nav-link" })
                            </li>
                            <li>
                                @Html.ActionLink("Carga Carpeta", "InfoCarpeta", "Comprobacion", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }
                        <li>
                            @Html.ActionLink("Cerrar sesión", "cerrar", "Comprobacion", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    </ul>
                }
                <ul class="nav navbar-nav navbar-right" style="color:white">
                    <li><h4>@ViewBag.Usuario</h4></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <div class="pull-right">
                <a href="http://trijaev.gob.mx" target="_blank">TRIJAEV</a> - Dirección de Administración/Subdirección de Innovación Tecnológica
            </div>
        </footer>
    </div>
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/angular-route.min.js"></script>
    <script src="~/Scripts/angular-resource.min.js"></script>
    <script src="~/Scripts/sweetalert.min.js"></script>
    <script>
        var raiz = '@Url.Content("~/")';
    </script>
    <script src="~/Scripts/comprobacion.js"></script>
    <script src="~/Scripts/app/aplicacion.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
